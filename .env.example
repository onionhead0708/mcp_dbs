# Paths to DBeaver's config files. Usual folders:
#   Windows: %APPDATA%\DBeaverData\workspace6\General\.dbeaver\
#   macOS:   ~/Library/DBeaverData/workspace6/General/.dbeaver/
#   Linux:   ~/.local/share/DBeaverData/workspace6/General/.dbeaver/
# Use full paths (no ~ or %VARS%). Forward slashes work on Windows too.
DBEAVER_DATA_SOURCES_JSON=/path/to/DBeaverData/workspace6/General/.dbeaver/data-sources.json
DBEAVER_CREDENTIALS_CONFIG_JSON=/path/to/DBeaverData/workspace6/General/.dbeaver/credentials-config.json
