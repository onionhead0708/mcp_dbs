# Optional. mcp-dbs finds DBeaver's connections by itself in the usual places:
#   Windows: %APPDATA%\DBeaverData\workspace6
#   macOS:   ~/Library/DBeaverData/workspace6
#   Linux:   ~/.local/share/DBeaverData/workspace6, then Flatpak
#            (~/.var/app/io.dbeaver.DBeaverCommunity/data/DBeaverData/workspace6)
#            and Snap (~/snap/dbeaver-ce/current/.local/share/DBeaverData/workspace6)
# Every project in the workspace is read. Set one of these only if yours is elsewhere.
# Paths may start with ~. Forward slashes work on Windows too.

# A whole DBeaver workspace (the folder that holds General/ and your other projects):
# DBEAVER_WORKSPACE=/path/to/DBeaverData/workspace6

# Or exactly one pair of files (the credentials file defaults to the one next to data-sources.json):
# DBEAVER_DATA_SOURCES_JSON=/path/to/DBeaverData/workspace6/General/.dbeaver/data-sources.json
# DBEAVER_CREDENTIALS_CONFIG_JSON=/path/to/DBeaverData/workspace6/General/.dbeaver/credentials-config.json

# DBDelve is found by itself too:
#   Windows: %APPDATA%\dbdelve   macOS: ~/Library/Application Support/dbdelve
#   Linux:   $XDG_DATA_HOME/dbdelve or ~/.local/share/dbdelve
# Use a DBDelve variant's folder and keychain entries (dbdelve-<variant>):
# DBDELVE_VARIANT=
# Or a profiles.toml somewhere else (passwords still come from the variant's keychain entries):
# DBDELVE_PROFILES=/path/to/profiles.toml

# An ssh config file for SSH tunnels, instead of ~/.ssh/config:
# MCP_DBS_SSH_CONFIG=/path/to/ssh_config
